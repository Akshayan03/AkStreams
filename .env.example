# Copy to .env. Keep credentials out of Git.
PORT=8787
# Optional: YouTube Data API v3 key for discovering current live streams
YOUTUBE_API_KEY=
# Comma-separated official channels you want to search. Must be channels with rights to stream the content.
# Get channel IDs from their official channel URLs or YouTube API.
OFFICIAL_YOUTUBE_CHANNEL_IDS=
# Optional comma-separated HTTPS URLs to M3U playlists you are authorized to use.
AUTHORIZED_M3U_URLS=
# Optional local playlist file, e.g. ./config/streams.m3u (your own authorized streams)
AUTHORIZED_M3U_FILE=
# Set true to show a sample HLS test source for demo fixture cards only.
DEMO_STREAM=false
