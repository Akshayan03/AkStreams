# Copy to .env (git-ignored). Never commit real keys or private playlist URLs.
# Validate with: npm run check-config   (add -- --live to test the key and playlists)

# AKStreams only listens on loopback. HOST may be 127.0.0.1 (default), localhost or ::1.
PORT=8787
HOST=127.0.0.1

# Optional: YouTube Data API v3 key (server-side only; never exposed to the browser).
YOUTUBE_API_KEY=
# Comma-separated official channel IDs (UC + 22 chars) that hold streaming rights. Max 10 searched.
OFFICIAL_YOUTUBE_CHANNEL_IDS=

# Optional comma-separated public https:// M3U playlist URLs you are authorized to use (max 5).
AUTHORIZED_M3U_URLS=
# Optional local playlist file, relative to the project root, e.g. ./config/streams.m3u
AUTHORIZED_M3U_FILE=

# true = attach public HLS test clips (Mux, Apple; not sports) to demo fixtures only.
DEMO_STREAM=false

# Extra loopback origins allowed to call the API (e.g. http://localhost:3000). Optional.
ALLOWED_ORIGINS=
