{
  "name": "akstreams",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run build && node server/index.mjs",
    "serve": "node server/index.mjs",
    "start:api": "node server/index.mjs",
    "check-config": "node scripts/check-config.mjs",
    "test": "node --test server/tests/*.test.mjs web/src/lib/*.test.ts",
    "test:live": "AKSTREAMS_LIVE=1 node --test server/tests/live.test.mjs",
    "typecheck": "npm run typecheck --workspace web",
    "build": "npm run build --workspace web",
    "e2e": "npm run build && playwright test --project=fixture",
    "e2e:live": "npm run build && playwright test --project=live"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
